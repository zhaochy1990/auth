{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Serve",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/sources/dev/authentication-go/cmd/auth-service",
            "buildFlags": [
                "-tags",
                "swagger"
            ],
            "args": [
                "serve",
                "--config",
                "${workspaceFolder}/sources/dev/authentication-go/config.local.yml"
            ],
            "env": {
                "MYSQL_DSN": "root:root_password@tcp(127.0.0.1:3306)/auth?charset=utf8mb4&parseTime=True&loc=Local",
                "SWAGGER_ENABLED": "true",
                "SERVER_PORT": "3100"
            },
            "cwd": "${workspaceFolder}/sources/dev/authentication-go"
        }
    ]
}